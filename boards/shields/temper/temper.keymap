// Miryoku layout (https://github.com/manna-harbour/miryoku), ported from the
// QMK build in users/manna-harbour_miryoku with these local customisations:
//   - Base alphas: Colemak-DH, ';' on the top right pinky
//   - Home row mods: Ctrl / Alt / Gui / Shift (inner-to-outer), AltGr on X and .
//   - Clipboard: MIRYOKU_CLIPBOARD=MAC
//   - Nav / Num / Sym / Fun tweaked per custom_config.h
//   - Tapping term 175ms

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define U_BASE   0
#define U_EXTRA  1
#define U_TAP    2
#define U_BUTTON 3
#define U_NAV    4
#define U_MOUSE  5
#define U_MEDIA  6
#define U_NUM    7
#define U_SYM    8
#define U_FUN    9

#define U_TAPPING_TERM 175

// Clipboard (MIRYOKU_CLIPBOARD=MAC)
#define U_RDO &kp LS(LG(Z))
#define U_PST &kp LG(V)
#define U_CPY &kp LG(C)
#define U_CUT &kp LG(X)
#define U_UND &kp LG(Z)

// U_NA: present but not available for use.  U_NU: available but not used.
#define U_NA &none
#define U_NU &none

// QMK has no PERMISSIVE_HOLD / HOLD_ON_OTHER_KEY_PRESS here, so a mod-tap or
// layer-tap only resolves as a hold once the tapping term expires. That is
// ZMK's "tap-preferred" flavor.
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <U_TAPPING_TERM>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <U_TAPPING_TERM>;
};

/ {
    behaviors {
        // Shift + caps word = caps lock (QMK capsword_key_override).
        u_cw: caps_word_or_caps_lock {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Additional features double tap guard: single tap does nothing,
        // double tap performs the action (QMK tap dance u_td_fn_*).
        u_td_boot: tap_dance_boot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&bootloader>;
        };
        u_td_base: tap_dance_base {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_BASE>;
        };
        u_td_extra: tap_dance_extra {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_EXTRA>;
        };
        u_td_tap: tap_dance_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_TAP>;
        };
        u_td_nav: tap_dance_nav {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_NAV>;
        };
        u_td_mouse: tap_dance_mouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_MOUSE>;
        };
        u_td_media: tap_dance_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_MEDIA>;
        };
        u_td_num: tap_dance_num {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_NUM>;
        };
        u_td_sym: tap_dance_sym {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_SYM>;
        };
        u_td_fun: tap_dance_fun {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <U_TAPPING_TERM>;
            bindings = <&none>, <&to U_FUN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp Q         &kp W         &kp F         &kp P         &kp B             &kp J         &kp L         &kp U         &kp Y        &kp SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
   &mt LCTRL A   &mt LALT R    &mt LGUI S    &mt LSHFT T      &kp G             &kp M      &mt LSHFT N   &mt LGUI E    &mt LALT I   &mt LCTRL O
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
 &lt U_BUTTON Z  &mt RALT X       &kp C         &kp D         &kp V             &kp K         &kp H      &kp COMMA    &mt RALT DOT &lt U_BUTTON FSLH
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                              &lt U_MEDIA ESC &lt U_NAV SPACE &lt U_MOUSE TAB  &lt U_SYM RET &lt U_NUM BSPC &lt U_FUN DEL
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        extra_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &mt LGUI A   &mt LALT S    &mt LCTRL D   &mt LSHFT F      &kp G             &kp H      &mt LSHFT J   &mt LCTRL K   &mt LALT L   &mt LGUI SQT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
 &lt U_BUTTON Z  &mt RALT X       &kp C         &kp V         &kp B             &kp N         &kp M      &kp COMMA    &mt RALT DOT &lt U_BUTTON FSLH
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                              &lt U_MEDIA ESC &lt U_NAV SPACE &lt U_MOUSE TAB  &lt U_SYM RET &lt U_NUM BSPC &lt U_FUN DEL
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        tap_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp Q         &kp W         &kp F         &kp P         &kp B             &kp J         &kp L         &kp U         &kp Y        &kp SQT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp A         &kp R         &kp S         &kp T         &kp G             &kp M         &kp N         &kp E         &kp I         &kp O
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp Z         &kp X         &kp C         &kp D         &kp V             &kp K         &kp H       &kp COMMA      &kp DOT      &kp FSLH
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp ESC     &kp SPACE      &kp TAB           &kp RET      &kp BSPC       &kp DEL
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        button_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      U_UND         U_CUT         U_CPY         U_PST         U_RDO             U_RDO         U_PST         U_CPY         U_CUT         U_UND
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT        U_NU              U_NU        &kp LSHFT     &kp LCTRL     &kp LALT      &kp LGUI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      U_UND         U_CUT         U_CPY         U_PST         U_RDO             U_RDO         U_PST         U_CPY         U_CUT         U_UND
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                 &mkp MCLK     &mkp LCLK     &mkp RCLK         &mkp RCLK     &mkp LCLK     &mkp MCLK
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        nav_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &u_td_boot    &u_td_tap    &u_td_extra   &u_td_base       U_RDO             U_RDO         U_PST         U_CPY         U_CUT         U_UND
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LCTRL     &kp LALT      &kp LGUI     &kp LSHFT      &kp LG(S)           &u_cw       &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      U_UND         U_CUT         U_CPY         U_NA          U_PST            &kp INS      &kp HOME     &kp PG_DN     &kp PG_UP      &kp END
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   U_NA          U_NA          U_NA             &kp RET      &kp BSPC       &kp DEL
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        mouse_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &u_td_boot    &u_td_tap    &u_td_extra   &u_td_base        U_NA             U_RDO         U_PST         U_CPY         U_CUT         U_UND
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LCTRL     &kp LALT      &kp LGUI     &kp LSHFT         U_NA              U_NU     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       U_NA       &kp RALT      &u_td_sym    &u_td_mouse       U_NA              U_NU     &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   U_NA          U_NA          U_NA            &mkp RCLK     &mkp LCLK     &mkp MCLK
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        media_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &u_td_boot    &u_td_tap    &u_td_extra   &u_td_base        U_NA          &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LCTRL     &kp LALT      &kp LGUI     &kp LSHFT         U_NA              U_NU      &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP   &kp C_NEXT
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       U_NA       &kp RALT      &u_td_fun    &u_td_media       U_NA         &out OUT_TOG       U_NU          U_NU          U_NU          U_NU
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   U_NA          U_NA          U_NA           &kp C_STOP     &kp C_PP     &kp C_MUTE
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        num_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &kp LBKT      &kp N7        &kp N8        &kp N9       &kp RBKT            U_NA        &u_td_base   &u_td_extra    &u_td_tap    &u_td_boot
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &kp SQT       &kp N4        &kp N5        &kp N6       &kp EQUAL           U_NA         &kp LSHFT     &kp LGUI      &kp LALT     &kp LCTRL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp GRAVE      &kp N1        &kp N2        &kp N3       &kp BSLH            U_NA         &u_td_num    &u_td_nav      &kp RALT        U_NA
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp DOT       &kp N0     &kp MINUS           U_NA          U_NA          U_NA
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        sym_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &kp LBRC     &kp AMPS      &kp ASTRK     &kp EXCL      &kp RBRC            U_NA        &u_td_base   &u_td_extra    &u_td_tap    &u_td_boot
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &kp DQT    &kp KP_EQUAL   &kp UNDER      &kp DLLR    &kp KP_PLUS           U_NA         &kp LSHFT     &kp LGUI      &kp LALT     &kp LCTRL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp TILDE      &kp LT     &kp KP_MINUS     &kp GT       &kp PIPE            U_NA        &kp PRCNT     &kp HASH      &kp CARET       U_NA
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                  &kp LPAR      &kp RPAR      &kp AT            U_NA          U_NA          U_NA
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        fun_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &kp F12       &kp F7        &kp F8        &kp F9      &kp PSCRN            U_NA        &u_td_base   &u_td_extra    &u_td_tap    &u_td_boot
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &kp F11       &kp F4        &kp F5        &kp F6       &kp SLCK            U_NA         &kp LSHFT     &kp LGUI      &kp LALT     &kp LCTRL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &kp F10       &kp F1        &kp F2        &kp F3   &kp PAUSE_BREAK         U_NA         &u_td_fun    &u_td_media    &kp RALT        U_NA
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                 &kp K_APP     &kp SPACE      &kp TAB           U_NA          U_NA          U_NA
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
